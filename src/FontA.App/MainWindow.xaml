<Window x:Class="FontA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FontA.App"
        Title="FontA">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- sidebar: one scrolling column, so the mouse wheel scrolls it wherever the pointer is over it (search box, rows, gaps, button) -->
    <ScrollViewer x:Name="SidebarScroll" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <AutoSuggestBox x:Name="SearchBox" Margin="10,12,10,6" PlaceholderText="Search fonts" QueryIcon="Find"
                        ToolTipService.ToolTip="Search fonts (Ctrl+F)" TextChanged="OnSearchChanged"/>
        <ListView x:Name="NavList" SelectionChanged="OnNavChanged" Padding="6,0"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"/>
        <Button x:Name="AddFolderButton" Margin="10,10,10,16" HorizontalAlignment="Center" Padding="18,6"
                CornerRadius="16" Click="OnAddFolder" ToolTipService.ToolTip="Add a folder of fonts (Ctrl+O)">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="14"/>
            <TextBlock Text="Add folder" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
    <!-- font list -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Padding="16,10,12,6" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SampleBox" PlaceholderText="Type here to preview your own text"
                 ToolTipService.ToolTip="Sample text (Ctrl+L). Press F1 for all shortcuts."
                 Text="The quick brown fox jumps over the lazy dog" TextChanged="OnSampleChanged"/>
        <Slider x:Name="ListSizeSlider" Grid.Column="1" Width="200" Minimum="14" Maximum="120" Value="36" StepFrequency="2"
                VerticalAlignment="Center" ThumbToolTipValueConverter="{x:Null}" ValueChanged="OnListSizeChanged"
                ToolTipService.ToolTip="Text size in the list (Ctrl+= and Ctrl+-)"/>
        <TextBlock x:Name="ListSizeText" Grid.Column="2" Text="36px" Width="44" VerticalAlignment="Center" Opacity="0.8"/>
        <Button Grid.Column="3" Click="OnResetListSize" ToolTipService.ToolTip="Reset size (Ctrl+0)"
                Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
        <Button Grid.Column="4" Click="OnToggleTheme" ToolTipService.ToolTip="Switch between dark and light"
                Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE793;" FontSize="14"/></Button>
        <Button Grid.Column="5" Click="OnOpenSettings" ToolTipService.ToolTip="Settings (Ctrl+,)"
                Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
      </Grid>

      <Grid x:Name="ScanPanel" Grid.Row="1" Visibility="Collapsed" Padding="16,0,12,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="ScanStatus" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="ScanBar" IsIndeterminate="True" Minimum="0" Maximum="1"/>
        </StackPanel>
        <Button x:Name="ScanCancel" Grid.Column="1" Content="Cancel" VerticalAlignment="Bottom" Click="OnCancelScan"/>
      </Grid>

      <StackPanel Grid.Row="2">
        <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Success" Margin="12,0,12,8">
          <InfoBar.ActionButton>
            <Button Content="Restart now" Click="OnRestartForUpdate"/>
          </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar x:Name="UnusedBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="12,0,12,8">
          <InfoBar.ActionButton>
            <Button x:Name="UndoUnusedButton" Content="Undo" Click="OnUndoUnused"/>
          </InfoBar.ActionButton>
        </InfoBar>
      </StackPanel>

      <ListView x:Name="FontGrid" Grid.Row="3" Padding="8,0,8,8" SelectionMode="Single" SelectionChanged="OnFontSelected"
                IsSynchronizedWithCurrentItem="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ContainerContentChanging="OnContainerChanging">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.GroupStyle>
          <GroupStyle HidesIfEmpty="True">
            <GroupStyle.HeaderContainerStyle>
              <Style TargetType="ListViewHeaderItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </GroupStyle.HeaderContainerStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate x:DataType="local:FontGroup">
                <Grid Padding="8,16,8,4" ColumnSpacing="6" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      ToolTipService.ToolTip="{x:Bind Key}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <local:ActivationDot State="{x:Bind ActiveState, Mode=OneWay}" Click="OnGroupDotClick"/>
                  <TextBlock Grid.Column="1" Text="{x:Bind Display}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" Opacity="0.55" VerticalAlignment="Center"
                             Margin="6,2,0,0"/>
                </Grid>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:FontItem">
            <Grid Padding="8,8,8,4" RowSpacing="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <local:ActivationDot State="{x:Bind ActiveState, Mode=OneWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                     Click="OnCardDotClick"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Format}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                <Button Grid.Column="4" Click="OnAlwaysClick" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" Opacity="{x:Bind AlwaysOpacity, Mode=OneWay}"
                        Background="Transparent" BorderThickness="0" Padding="8,4" MinWidth="0" MinHeight="0"
                        ToolTipService.ToolTip="Always active: switch on every time FontA starts and keep on after it closes">
                  <FontIcon Glyph="&#xE718;" FontSize="14"/>
                </Button>
                <Button Grid.Column="5" Click="OnFavoriteClick" Opacity="{x:Bind FavoriteOpacity, Mode=OneWay}"
                        Background="Transparent" BorderThickness="0" Padding="8,4" MinWidth="0" MinHeight="0"
                        ToolTipService.ToolTip="Favorite (Ctrl+D)">
                  <TextBlock Text="{x:Bind FavoriteGlyph, Mode=OneWay}" FontFamily="Segoe UI Symbol" FontSize="16"/>
                </Button>
              </Grid>
              <Image Grid.Row="1" Source="{x:Bind Thumbnail, Mode=OneWay}" Height="{x:Bind RowThumbHeight, Mode=OneWay}"
                     Width="1400" Stretch="Fill" HorizontalAlignment="Left" Margin="6,0,0,0"/>
              <TextBlock Grid.Row="2" Text="File missing. Rescan the folder to remove it." Visibility="{x:Bind MissingVisibility, Mode=OneWay}"
                         Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <!-- details: shown once a font is picked -->
    <Border x:Name="DetailsPane" Grid.Column="2" Width="340" Visibility="Collapsed"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="10">
          <TextBlock x:Name="PreviewTitle" Text="Select a font" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
          <Image x:Name="PreviewImage" Width="308" Height="240" Stretch="Fill" HorizontalAlignment="Left"/>
          <Slider x:Name="SizeSlider" Header="Size" Minimum="12" Maximum="160" Value="48" ValueChanged="OnPreviewParamChanged"/>
          <Button x:Name="InstallButton" Content="Install" Click="OnInstallSelected"
                  ToolTipService.ToolTip="Install for your Windows account so it stays available without FontA (Ctrl+Shift+I)"/>
          <TextBlock Text="Organize" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <DropDownButton x:Name="CollectionsButton" Content="Collections" IsEnabled="False"/>
          <ItemsControl x:Name="TagsPanel">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBox x:Name="NewTagBox" PlaceholderText="Add tag and press Enter" KeyDown="OnNewTagKeyDown" IsEnabled="False"/>
          <TextBlock Text="Variable axes" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <StackPanel x:Name="AxesPanel" Spacing="4"/>
          <TextBlock Text="OpenType features" Style="{StaticResource BodyStrongTextBlockStyle}"/>
          <ItemsControl x:Name="FeaturesPanel">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
