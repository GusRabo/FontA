<Window x:Class="FontA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FontA">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Padding="12" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search fonts (Ctrl+F)" QueryIcon="Find"
                      TextChanged="OnSearchChanged"/>
      <TextBox x:Name="SampleBox" ToolTipService.ToolTip="Sample text (Ctrl+L). Press F1 for all shortcuts." Grid.Column="1" Text="The quick brown fox jumps over the lazy dog"
               TextChanged="OnSampleChanged"/>
      <Button x:Name="AddFolderButton" Grid.Column="2" Content="Add folder…" Click="OnAddFolder"
              ToolTipService.ToolTip="Add folder (Ctrl+O)"/>
      <Button Grid.Column="3" Content="⚙" Click="OnOpenSettings" ToolTipService.ToolTip="Settings (Ctrl+,)"/>
    </Grid>
    <StackPanel Grid.Row="2">
      <InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="True" Severity="Success" Margin="12,0,12,8">
        <InfoBar.ActionButton>
          <Button Content="Restart now" Click="OnRestartForUpdate"/>
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="UnusedBar" IsOpen="False" IsClosable="True" Severity="Informational" Margin="12,0,12,8">
        <InfoBar.ActionButton>
          <Button x:Name="UndoUnusedButton" Content="Undo" Click="OnUndoUnused"/>
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>
    <Grid x:Name="ScanPanel" Grid.Row="1" Visibility="Collapsed" Padding="12,0,12,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock x:Name="ScanStatus" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="ScanBar" IsIndeterminate="True" Minimum="0" Maximum="1"/>
      </StackPanel>
      <Button x:Name="ScanCancel" Grid.Column="1" Content="Cancel" VerticalAlignment="Bottom" Click="OnCancelScan"/>
    </Grid>
    <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListView x:Name="NavList" SelectionChanged="OnNavChanged"/>
      <Button Grid.Row="1" Margin="8" HorizontalAlignment="Stretch" Content="＋ New collection" Click="OnNewCollection"
              ToolTipService.ToolTip="New collection (Ctrl+N)"/>
    </Grid>
    <GridView x:Name="FontGrid" Grid.Column="1" Padding="12" SelectionMode="Single" SelectionChanged="OnFontSelected"
              ContainerContentChanging="OnContainerChanging">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="local:FontItem" xmlns:local="using:FontA.App">
          <StackPanel Width="320" Padding="12" Spacing="4"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"/>
            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="296" Height="64" Stretch="None"
                   HorizontalAlignment="Left"/>
            <TextBlock Text="File missing. Rescan the folder to remove it." Visibility="{x:Bind MissingVisibility, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ToggleButton Content="Active" IsChecked="{x:Bind IsActive, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"/>
              <ToggleButton Content="★" IsChecked="{x:Bind IsFavorite, Mode=TwoWay}" ToolTipService.ToolTip="Favorite (Ctrl+D)"/>
              <ToggleButton Content="Always" IsChecked="{x:Bind IsAlwaysActive, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                            ToolTipService.ToolTip="Activate automatically every time FontA starts, and keep active after it closes"/>
              <Button Content="{x:Bind InstallLabel, Mode=OneWay}" Click="OnInstallClick"
                      ToolTipService.ToolTip="Install for your Windows account so it stays available without FontA"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
    <ScrollViewer Grid.Column="2" Padding="12">
      <StackPanel Spacing="10">
        <TextBlock x:Name="PreviewTitle" Text="Select a font" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left"/>
        <Slider x:Name="SizeSlider" Header="Size" Minimum="12" Maximum="160" Value="48" ValueChanged="OnPreviewParamChanged"/>
        <TextBlock Text="Organize" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <DropDownButton x:Name="CollectionsButton" Content="Collections" IsEnabled="False"/>
        <ItemsControl x:Name="TagsPanel">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBox x:Name="NewTagBox" PlaceholderText="Add tag and press Enter" KeyDown="OnNewTagKeyDown" IsEnabled="False"/>
        <TextBlock Text="Variable axes" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel x:Name="AxesPanel" Spacing="4"/>
        <TextBlock Text="OpenType features" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <ItemsControl x:Name="FeaturesPanel">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Grid>
</Window>
