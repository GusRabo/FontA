<Project>
  <PropertyGroup>
    <!--
      Record the exact version and hash of every NuGet package in packages.lock.json (committed). Release and CI builds
      restore in locked mode, so a package that changed upstream, or was swapped, makes the build fail instead of
      silently shipping different code.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <Product>FontA</Product>
    <Authors>GusRabo</Authors>
    <Company>GusRabo</Company>
    <Copyright>Copyright (C) 2026 GusRabo and FontA contributors. Licensed under the GNU GPL v3.</Copyright>
    <Description>A fast, native Windows font manager.</Description>
    <RepositoryUrl>https://github.com/GusRabo/FontA</RepositoryUrl>
  </PropertyGroup>
</Project>
